# ─────────────── ATHANA platform — environment variables ───────────────
# Copy to .env (development) or set in your hosting provider (staging / production).
# Never commit real values. See docs/ENVIRONMENT.md for details.

# Required
DATABASE_URL="postgresql://athana:CHANGE_ME@localhost:5432/athana"
APP_URL="http://localhost:3000"                 # public origin, no trailing slash (https://athana.ch in production)
SESSION_SECRET=""                               # openssl rand -base64 48  (≥ 32 chars, required in production)

# Payments — "test" is a sandbox that never moves money and is refused in production
PAYMENTS_MODE="test"                            # test | stripe
# ALLOW_TEST_PAYMENTS="true"                    # staging only: allows PAYMENTS_MODE=test with NODE_ENV=production
STRIPE_SECRET_KEY=""                            # sk_live_… / sk_test_…
STRIPE_WEBHOOK_SECRET=""                        # whsec_… of the endpoint https://<domain>/api/webhooks/stripe

# E-mail — "log" stores messages in the database without sending
EMAIL_PROVIDER="log"                            # log | resend
RESEND_API_KEY=""
EMAIL_FROM="Athana <contact@athana.ch>"
CONTACT_EMAIL="contact@athana.ch"               # receives internal notifications (orders, leads)

# Files
STORAGE_DIR="./storage"                         # private uploads; must be a persistent volume in production

# Scheduler — protects GET /api/cron/daily (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# SEO — set to "true" on the production domain only (staging stays non-indexable)
ALLOW_INDEXING="false"

# Marketing tags (loaded only after visitor consent; leave empty to disable)
NEXT_PUBLIC_GA4_ID=""                           # G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=""                           # GTM-XXXXXXX (takes precedence over the GA4 / Ads tags)
NEXT_PUBLIC_GOOGLE_ADS_ID=""                    # AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Seed (first installation only)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""                          # ≥ 12 characters; change after first login
# SEED_DEMO="true"                              # adds the TEST10 sandbox coupon

# Tests
TEST_DATABASE_URL="postgresql://athana:CHANGE_ME@localhost:5432/athana_test"
